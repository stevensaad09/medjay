# Cloudflare Pages headers (https://developers.cloudflare.com/pages/configuration/headers/)
# Course PDFs and zips must not appear in search results; search engines
# should send people to the course pages instead.
/courses/files/*
  X-Robots-Tag: noindex

# Self-hosted web fonts: file names are content-specific, safe to cache for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
